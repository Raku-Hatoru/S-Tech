# --- Dependensi (dibuat ulang: composer install / npm ci)
/vendor
/node_modules

# --- Hasil build frontend (dibuat ulang: npm run build)
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# --- Berkas rahasia dan konfigurasi lingkungan lokal
.env
.env.*
!.env.example
.audit-credentials
/auth.json

# --- Berkas log, kunci enkripsi, dan cache aplikasi
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/storage/*.key
/storage/pail
/storage/app/imports/*
!/storage/app/imports/.gitignore
.phpunit.result.cache
/.phpunit.cache
.php-cs-fixer.cache
.phpactor.json
_ide_helper.php

# --- Basis data lokal dan berkas dump
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm
*.sqlite
*.sqlite-journal
*.sql
*.sql.gz
*.dump

# --- Artefak pengujian dan audit browser (bisa dibuat ulang)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
